# Development Environment Configuration

# Server
NODE_ENV=development
PORT=3000
WS_PORT=8080
LOG_LEVEL=debug

# Database (Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webrtc_recorder
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=dev-secret-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081

# TLS (disable for development)
TLS_ENABLED=false

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_SAMPLE_RATE=100
TELEMETRY_BATCH_SIZE=10

# API
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW_MS=60000

# Database Backup
BACKUP_ENABLED=false

# Email Notifications (optional)
SMTP_ENABLED=false

# Feature Flags
FEATURE_WEBRTC_RECORDING=true
FEATURE_VIDEO_RECORDING=false
FEATURE_ENTERPRISE_FEATURES=false
