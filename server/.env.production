# Production Environment Configuration
# ⚠️ CRITICAL: All sensitive values must be set via environment variables
# Never commit actual secrets to version control

# Server
NODE_ENV=production
PORT=3000
WS_PORT=8080
LOG_LEVEL=warn

# Database (AWS RDS)
# Set via environment variable: DATABASE_URL
# Format: postgresql://user:password@host:port/dbname
DB_POOL_MIN=5
DB_POOL_MAX=30
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000

# JWT
# Set via environment variable: JWT_SECRET (minimum 40 chars, use secure random)
JWT_EXPIRES_IN=24h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# CORS (restrict to known domains)
ALLOWED_ORIGINS=https://api.example.com,https://app.example.com,https://dashboard.example.com

# TLS/SSL
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/fullchain.pem
TLS_KEY_PATH=/etc/ssl/private/privkey.pem

# Monitoring & Observability
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_NAMESPACE=webrtc_prod

# CloudWatch / Prometheus Integration
CLOUDWATCH_ENABLED=true
CLOUDWATCH_NAMESPACE=WebRTCCallRecorder
PROMETHEUS_ENABLED=true

# Telemetry (strict in production)
TELEMETRY_ENABLED=true
TELEMETRY_SAMPLE_RATE=10
TELEMETRY_BATCH_SIZE=100
TELEMETRY_BATCH_TIMEOUT_MS=30000

# API Security
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_MS=60000
API_KEY_ROTATION_DAYS=30

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM UTC
BACKUP_RETENTION_DAYS=30

# Email Notifications
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
ALERTING_EMAIL=alerts@example.com

# KMS (Key Management Service) for secrets
KMS_ENABLED=true
KMS_REGION=us-east-1
KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID

# Logging (ECS/CloudWatch)
LOG_FORMAT=json
LOG_DESTINATION=cloudwatch

# Feature Flags (disable risky features in production)
FEATURE_WEBRTC_RECORDING=true
FEATURE_VIDEO_RECORDING=false
FEATURE_ENTERPRISE_FEATURES=false
FEATURE_DEBUG_ENDPOINTS=false

# Security Headers
SECURITY_HEADER_CSP=true
SECURITY_HEADER_HSTS=true
SECURITY_HEADER_X_FRAME_OPTIONS=DENY

# Rate Limiting by IP
IP_RATE_LIMIT_ENABLED=true
IP_RATE_LIMIT_REQUESTS=1000
IP_RATE_LIMIT_WINDOW_MS=3600000

# DDoS Protection
DDOS_PROTECTION_ENABLED=true
DDOS_THRESHOLD_REQUESTS_PER_SEC=5000

# Incident Response
INCIDENT_SLACK_WEBHOOK= # Set via environment variable
INCIDENT_PAGERDUTY_API_KEY= # Set via environment variable
INCIDENT_RESPONSE_TEAM=ops-team@example.com
