{
    "dashboard": {
        "id": null,
        "uid": "consent-compliance",
        "title": "Consent Management & Compliance",
        "tags": [
            "webrtc",
            "consent",
            "compliance",
            "tier1"
        ],
        "timezone": "browser",
        "schemaVersion": 27,
        "version": 0,
        "refresh": "30s",
        "panels": [
            {
                "id": 1,
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 0,
                    "y": 0
                },
                "type": "stat",
                "title": "Total Consent Requests",
                "targets": [
                    {
                        "expr": "sum(consent_requests_total)",
                        "refId": "A"
                    }
                ],
                "options": {
                    "graphMode": "area",
                    "colorMode": "value",
                    "textMode": "value_and_name"
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "short"
                    }
                }
            },
            {
                "id": 2,
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 8,
                    "y": 0
                },
                "type": "stat",
                "title": "Consent Rate",
                "targets": [
                    {
                        "expr": "sum(consent_granted_total) / sum(consent_requests_total) * 100",
                        "refId": "A"
                    }
                ],
                "options": {
                    "graphMode": "area",
                    "colorMode": "value",
                    "textMode": "value_and_name"
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "percent",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 50,
                                    "color": "yellow"
                                },
                                {
                                    "value": 80,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 3,
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 16,
                    "y": 0
                },
                "type": "stat",
                "title": "Signature Verification Success",
                "targets": [
                    {
                        "expr": "sum(consent_signature_verified_total) / sum(consent_signature_checks_total) * 100",
                        "refId": "A"
                    }
                ],
                "options": {
                    "graphMode": "area",
                    "colorMode": "value",
                    "textMode": "value_and_name"
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "percent",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 95,
                                    "color": "yellow"
                                },
                                {
                                    "value": 99,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 4,
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "type": "bargauge",
                "title": "Consent Requests by Jurisdiction",
                "targets": [
                    {
                        "expr": "sum by (jurisdiction) (consent_requests_total)",
                        "legendFormat": "{{jurisdiction}}",
                        "refId": "A"
                    }
                ],
                "options": {
                    "orientation": "horizontal",
                    "displayMode": "gradient",
                    "showUnfilled": true
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "short"
                    }
                }
            },
            {
                "id": 5,
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "type": "piechart",
                "title": "Consent Methods",
                "targets": [
                    {
                        "expr": "sum by (method) (consent_method_total)",
                        "legendFormat": "{{method}}",
                        "refId": "A"
                    }
                ],
                "options": {
                    "legend": {
                        "displayMode": "table",
                        "placement": "right"
                    },
                    "pieType": "donut",
                    "displayLabels": [
                        "percent",
                        "name"
                    ]
                }
            },
            {
                "id": 6,
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                },
                "type": "timeseries",
                "title": "Right to Be Forgotten Requests",
                "targets": [
                    {
                        "expr": "rate(consent_rtbf_requests_total[1h])",
                        "legendFormat": "RTBF Requests/hour",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "ops",
                        "custom": {
                            "drawStyle": "bars",
                            "fillOpacity": 80
                        }
                    }
                }
            },
            {
                "id": 7,
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                },
                "type": "timeseries",
                "title": "Data Portability Exports",
                "targets": [
                    {
                        "expr": "rate(consent_data_export_total[1h])",
                        "legendFormat": "Exports/hour",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "ops",
                        "custom": {
                            "drawStyle": "bars",
                            "fillOpacity": 80
                        }
                    }
                }
            },
            {
                "id": 8,
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 24
                },
                "type": "table",
                "title": "Compliance Status by Region",
                "targets": [
                    {
                        "expr": "consent_compliance_status",
                        "format": "table",
                        "instant": true,
                        "refId": "A"
                    }
                ],
                "options": {
                    "showHeader": true
                },
                "fieldConfig": {
                    "defaults": {
                        "custom": {
                            "align": "auto",
                            "displayMode": "auto"
                        }
                    },
                    "overrides": [
                        {
                            "matcher": {
                                "id": "byName",
                                "options": "status"
                            },
                            "properties": [
                                {
                                    "id": "custom.displayMode",
                                    "value": "color-background"
                                },
                                {
                                    "id": "thresholds",
                                    "value": {
                                        "mode": "absolute",
                                        "steps": [
                                            {
                                                "value": 0,
                                                "color": "red"
                                            },
                                            {
                                                "value": 1,
                                                "color": "green"
                                            }
                                        ]
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        ],
        "time": {
            "from": "now-24h",
            "to": "now"
        }
    },
    "overwrite": true
}